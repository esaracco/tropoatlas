# Application identifier (do not change)
VITE_APP_NAME="tropoaudio"

# Data provider plugin (do not change)
VITE_DATA_PROVIDER="discogs"

# Discogs credentials (required)
# Obtain your personal API token at: https://www.discogs.com/settings/developers
VITE_DISCOGS_USER=""
DISCOGS_TOKEN=""

# Media formats to include: all, vinyl, cd, cassette, sacd (default: all)
# VITE_DISCOGS_FORMATS="all"

# Only show albums with custom fields: place, price, categories (default: no)
# VITE_DISCOGS_FIELDS_REQUIRED="no"

# Currency symbol displayed for prices (default: €)
# VITE_CURRENCY="€"

# LED shelf locator (optional)
# Set to "yes" to enable physical LEDs on your ESP32 controller
VITE_SET_LEDS="no"
# VITE_LED_TARGET="http://127.0.0.1:8000"
# VITE_LEDS_CREATORS_COLOR="0,0,130"
# VITE_LEDS_CATEGORIES_COLOR="0,150,0"
# VITE_LEDS_WORK_COLOR="255,0,0"

# Development mode: disables remote cover artwork fetching (default: no)
# VITE_DEV_MODE="no"
