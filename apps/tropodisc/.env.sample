#
# App name (do not change)
#
VITE_APP_NAME="tropodisc"

#
# Data Provider
#
# (*) The data provider to use

VITE_DATA_PROVIDER="discogs"

#
# DISCOGS AUTH
#
# (*) Your Discogs user.

VITE_DISCOGS_USER=

# (*) Your Discogs token.
#     (https://www.discogs.com/developers#page:authentication)

DISCOGS_TOKEN=

# Max number of items to retrieve per request to the Discogs API
# Default: 250
VITE_DISCOGS_API_ITEMS_PER_REQUEST=250

# Delay between Discogs API requests in seconds
# Default: 2 (2 seconds)
VITE_DISCOGS_API_REQUEST_DELAY=2

#
# ALBUMS
#
# Default: €

VITE_CURRENCY=€

# Media formats to take into account.
#
# -> Must be a correct Discogs format, lower case.
#   (https://www.discogs.com/fr/help/formatslist)
#
# Example:
#   - vinyl
#   - vinyl,cd,cassette,sacd
#
# Default: all

VITE_DISCOGS_FORMATS=all

#
# DISCOGS USER CUSTOM FIELDS
#
# (https://support.discogs.com/hc/en-us/articles/360007331674-Customizing-Your-Collection-Notes)
#

# This field is for the location of the album in your audio library.
#
# -> Name it as you want, but create it first on Discogs!
#
# [ Discogs value:
#   --------------
#   It represents the physical location of the album in your audio library.
#   
#   If VITE_SET_LEDS is set to "yes", the value you assign to it on
#   Discogs must be numeric. Otherwise, it can be whatever you like :-)
#
#   Example: 34
# ]
#
# Example: place

VITE_DISCOGS_FIELD_PLACE=

# This field is for the album purchase price.
#
# -> Name it as you want, but create it first on Discogs!
#
# [ Discogs value:
#   --------------
#   The value you give it on Discogs should be a price, without the currency.
#
#   Example: 67
# ]
#
# Example: price

VITE_DISCOGS_FIELD_PRICE=

# This field is for your own custom album styles.
# This allows you to use a simpler classification than the
# plethora of existing Discogs styles.
#
# -> Name it as you want, but create it first on Discogs!
#
# [ Discogs value:
#   --------------
#   The value you give it on Discogs should be one or more custom styles
#   (separated by commas if there are multiple). You can name them however you like.
#
#   Example:
#     - Rock
#     - Chanson,Pop
#     - Hard Rock,Metal,Live
# ]
#
# Example: styles

VITE_DISCOGS_FIELD_STYLES=

# If "yes", only albums that have at least one VITE_DISCOGS_FIELD_*
# field will be displayed.
#
# Default: no

VITE_DISCOGS_FIELDS_REQUIRED=no

#
# LEDS
#
# If "yes", TropoDisc will try to contact your audio library
# server to control LEDs.
#
# This feature requires an embedded server on a microcontroller to
# control LED strips. However, if you are interested, do not
# hesitate to contact me :-) You can also take a look at the
# "firmware/led-controller/" directory.
#
# -> If "yes", do not forget to adapt VITE_LEDS_API_PORT and
#    VITE_AUDIOLIBRARY_URL.
#
# Default: no
# -> You can leave it blank.

VITE_SET_LEDS=no

# Default: 0,0,130

VITE_LEDS_ARTISTS_COLOR=0,0,130

# Default: 0,150,0

VITE_LEDS_STYLES_COLOR=0,150,0

# Default: 255,0,0

VITE_LEDS_ALBUM_COLOR=255,0,0

# API server port (only needed if VITE_SET_LEDS is "yes")
#
# The port used by the apache (or equivalent) ProxyPass directive:
#
#   ProxyPass "/" "http://localhost:10000/"
#
# -> Do not forget to adapt VITE_AUDIOLIBRARY_URL.
#
# Default: 10000

VITE_LEDS_API_PORT=10000

# Audio library server URL (only needed if VITE_SET_LEDS is "yes")
#
# The URL of your audio library Arduino server.

VITE_AUDIOLIBRARY_URL=http://myarduinoserver:8000

#------------------------------------------------------------------
#
# Notes:
#
# (*) Value is required for this field.
#
