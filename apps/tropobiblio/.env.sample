# Active data provider plugin.
# Note: The credentials and configuration variables below depend on the chosen provider.
VITE_DATA_PROVIDER="inventaire"

# Inventaire provider configuration (required when VITE_DATA_PROVIDER="inventaire")
# Your Inventaire.io username (or email) and password
VITE_INVENTAIRE_USER=""
VITE_INVENTAIRE_PASSWORD=""

# Currency symbol displayed for prices (default: €)
# VITE_CURRENCY="€"

# LED shelf locator (optional)
# Set to "yes" to enable physical LEDs on your ESP32 controller
VITE_SET_LEDS="no"
# VITE_LED_TARGET="http://192.168.1.1"
# VITE_LEDS_CREATORS_COLOR="0,0,130"
# VITE_LEDS_CATEGORIES_COLOR="0,150,0"
# VITE_LEDS_WORK_COLOR="255,0,0"

# Development mode: disables remote cover artwork fetching (default: no)
# VITE_DEV_MODE="no"
