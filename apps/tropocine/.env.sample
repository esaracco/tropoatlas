# Application identifier (do not change)
VITE_APP_NAME="tropocine"

# Data provider plugin (do not change)
VITE_DATA_PROVIDER="tmdb"

# TMDB credentials & list configuration (required)
# 1. Your TMDB list ID or slug (e.g., 8691537 or 8691537-my-list)
VITE_TMDB_LIST_ID=""

# 2. Obtain API Read Access Token at: https://www.themoviedb.org/settings/api
#    Then run `npm run auth:cine` to upgrade it for write access
TMDB_TOKEN=""

# Currency symbol displayed for prices (default: €)
# VITE_CURRENCY="€"

# LED shelf locator (optional)
# Set to "yes" to enable physical LEDs on your ESP32 controller
VITE_SET_LEDS="no"
# VITE_LED_TARGET="http://192.168.1.1"
# VITE_LEDS_CREATORS_COLOR="0,0,130"
# VITE_LEDS_CATEGORIES_COLOR="0,150,0"
# VITE_LEDS_WORK_COLOR="255,0,0"

# Development mode: disables remote cover artwork fetching (default: no)
# VITE_DEV_MODE="no"
