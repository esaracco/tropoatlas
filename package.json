{
  "name": "tropoatlas",
  "version": "2.0.0",
  "description": "TropoAtlas Ecosystem Workspace",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "author": "Emmanuel Saracco",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "audit": "npm audit --omit=dev --audit-level=high",
    "dev": "npm run dev -w apps/tropodisc",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "./node_modules/.bin/eslint apps/ packages/ plugins/",
    "lint-fix": "./node_modules/.bin/eslint --fix apps/ packages/ plugins/",
    "format": "./node_modules/.bin/prettier --write apps/ packages/ plugins/",
    "i18n:check": "npm run i18n:check -w apps/tropodisc",
    "pre-commit": "npm run lint && npm run format && npm run test && npm run i18n:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.20.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "prettier": "^3.9.6"
  }
}
